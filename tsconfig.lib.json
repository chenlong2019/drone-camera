{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    // 只产声明文件，JS 交给 vite.lib.config.ts（ESM / UMD 两套）
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": true,

    // 声明产物：drone-camera/index.d.ts + drone-camera/lib/*.d.ts
    // （tsc 按 rootDir=src/lib 镜像，先出 drone-camera/drone-camera/*.d.ts，
    //   再由 scripts/build-lib.mjs 把内层改名为 lib/）
    "rootDir": "./src/lib",
    "outDir": "./drone-camera",

    // 与 app 保持一致的下标安全策略
    "noUncheckedIndexedAccess": true,

    // 第三方 .d.ts（@types/three）不做检查，避免上游类型噪音阻塞库构建
    "skipLibCheck": true,

    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.lib.tsbuildinfo"
  },
  // 只纳入无人机控制系统：飞控 7 模块（drone-sim / drone-rig / drone-lights /
  // drone-world / drone-radar / mission-editor / drone-fly）
  "include": ["src/lib/index.ts", "src/lib/drone-camera/**/*.ts"]
}
